# Скопируйте этот файл в .env и заполните значения перед запуском на сервере:
#   cp .env.example .env

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Имя базы данных, общее для gateway и tracker.
POSTGRES_DB=my_life
# Пользователь и пароль базы. Обязательно смените пароль на сервере.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

# ---------------------------------------------------------------------------
# Gateway
# ---------------------------------------------------------------------------
# Секрет подписи JWT. Минимум 32 байта (256 бит) для HS256.
# Сгенерировать: openssl rand -base64 48
GATEWAY_JWT_SECRET=change-me-at-least-32-bytes-secret-value

# Время жизни access-токена (ISO-8601 duration).
GATEWAY_JWT_ACCESS_TOKEN_TTL=PT15M
# Время жизни refresh-токена.
GATEWAY_AUTH_REFRESH_TOKEN_TTL=P7D

# true — cookie refresh-токена только по HTTPS. На сервере без TLS оставьте false,
# иначе вход не будет сохраняться.
GATEWAY_AUTH_COOKIE_SECURE=false
# SameSite для refresh-cookie: Strict, Lax или None.
# Strict/Lax работают, когда фронтенд и API на одном домене (через nginx).
GATEWAY_AUTH_COOKIE_SAME_SITE=Lax

# ---------------------------------------------------------------------------
# Tracker
# ---------------------------------------------------------------------------
# Часовой пояс для расчёта дат привычек.
TRACKER_TIME_ZONE=Europe/Moscow

# ---------------------------------------------------------------------------
# Web (frontend)
# ---------------------------------------------------------------------------
# Порт на сервере, на котором будет доступен сайт.
WEB_PORT=80
# Базовый URL API. Оставьте пустым, если фронтенд и API отдаются с одного
# origin (nginx проксирует /auth и /tracker в gateway). Иначе укажите полный
# URL, например https://api.example.com
VITE_API_BASE_URL=
